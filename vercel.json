{
  "rewrites": [
    { "source": "/api/admin/me", "destination": "/api/admin/login?action=me" },
    { "source": "/api/admin/logout", "destination": "/api/admin/login?action=logout" }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/login.html",
      "permanent": false
    },
    {
      "source": "/origins.html",
